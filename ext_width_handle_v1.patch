+            }
+            if (_nc != gfx_char_cols) {
+                gfx_char_cols = _nc;
+                scr_ext_gfx_setup();
+                gfx_phase = gfx_addr mod gfx_row_bytes;
+            }
+        }
+    }
+    else {
+        gfx_width_drag = false;
+    }
+}
+if (gfx_handle_hover || gfx_width_drag) {
+    window_set_cursor(cr_size_we);
+}
+else {
+    window_set_cursor(cr_default);
+}
