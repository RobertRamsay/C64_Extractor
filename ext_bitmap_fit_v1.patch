+/// @desc scr_ext_gfx_nudge(bytes) - moves the viewer start by a number of bytes
+function scr_ext_gfx_nudge(_bytes) {
+    gfx_addr = (gfx_addr + _bytes) & 0xFFFF;
+    gfx_phase = gfx_addr mod gfx_row_bytes;
+    gfx_dirty = true;
+}
