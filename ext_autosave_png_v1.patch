+        _path += ".png";
+    }
+    scr_ext_gfx_render();
+    surface_save(gfx_surf, _path);
+    status_text = "Saved " + filename_name(_path) + " (" + string(gfx_img_w) + " x " + string(gfx_img_h) + ").";
