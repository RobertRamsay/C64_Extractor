+/// @desc scr_ext_finding_text(finding) - one line for the status bar / summary
+function scr_ext_finding_text(_c) {
+    var _t = _c.kind + " at $" + scr_ext_hex(_c.addr, 4) + "-$" + scr_ext_hex(_c.addr + _c.len - 1, 4);
+    _t += "   " + string(_c.conf) + "% confidence";
